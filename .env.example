# Copy this file's contents into Vercel Project Settings → Environment Variables.
# Never commit a real .env file with real credentials to GitHub.

# SMTP server that will send the email (see README for provider options)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# The account that logs in and sends the email
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# Where contact form messages should land (defaults to ankur.singh@apexon.com if unset)
CONTACT_TO_EMAIL=ankur.singh@apexon.com
